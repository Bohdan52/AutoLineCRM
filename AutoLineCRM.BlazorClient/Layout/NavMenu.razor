@using Microsoft.AspNetCore.Components.Authorization
@inject D20Tek.Blazor.BrowserStorage.ILocalStorageService Storage
@inject NavigationManager NavManager

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Головна</MudNavLink>
    <MudNavLink Href="/catalog" Icon="@Icons.Material.Filled.DirectionsCar">Каталог авто</MudNavLink>
    <MudNavLink Href="/my-requests" Icon="@Icons.Material.Filled.ListAlt">Мої заявки</MudNavLink>

    @* Блок, який бачать ТІЛЬКИ менеджери та адміністратори *@
    <AuthorizeView Roles="Manager,Administrator">
        <MudNavLink Href="/admin-requests" Icon="@Icons.Material.Filled.AdminPanelSettings">Панель менеджера</MudNavLink>
    </AuthorizeView>

    <br />
    <MudDivider />

    @* Блок входу/виходу *@
    <AuthorizeView>
        <Authorized>
            <MudNavLink OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Вийти</MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">Вхід</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    private async Task Logout()
    {
        
        await Storage.RemoveAsync("authToken");
        NavManager.NavigateTo("/login", forceLoad: true);
    }
}