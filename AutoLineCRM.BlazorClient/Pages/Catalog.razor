@page "/catalog"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using MudBlazor

<PageTitle>Каталог авто</PageTitle>

<style>
    .car-card { overflow: hidden; transition: transform .2s, box-shadow .2s; height: 100%; display: flex; flex-direction: column; }
    .car-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(15, 23, 42, .18) !important; }
    .car-photo { position: relative; height: 190px; background: linear-gradient(135deg, #1e293b, #475569); display: flex; align-items: center; justify-content: center; }
    .car-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .car-badge { position: absolute; top: 10px; left: 10px; z-index: 1; }
    .car-spec { display: flex; align-items: center; gap: 4px; color: #64748b; font-size: .85rem; }
    .car-menu { position: absolute; top: 8px; right: 8px; z-index: 2; background: rgba(255,255,255,.92); border-radius: 50%; }
    .edit-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,.55); z-index: 1150; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .edit-modal { background: #fff; border-radius: 12px; padding: 24px; width: 100%; max-width: 640px; max-height: 90vh; overflow: auto; }
    .edit-preview { width: 100%; height: 160px; object-fit: cover; border-radius: 8px; background: #1e293b; }
</style>

<MudText Typo="Typo.h4" Class="mb-1">Каталог автомобілів</MudText>

@if (cars == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-4" />
}
else
{
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">Знайдено: @Filtered.Count з @cars.Count</MudText>

    <MudPaper Class="pa-4 mb-6" Elevation="2">
        <MudGrid Spacing="3" AlignItems="AlignItems.Center">
            <MudItem xs="12" md="4">
                <MudTextField T="string" @bind-Value="search" Immediate="true" Label="Пошук (марка, модель)"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudSelect T="string" @bind-Value="brand" Label="Марка" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("")">Усі</MudSelectItem>
                    @foreach (var b in cars.Select(c => c.Brand).Distinct().OrderBy(x => x))
                    {
                        <MudSelectItem T="string" Value="@b">@b</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="sort" Label="Сортування" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("brand")">За маркою</MudSelectItem>
                    <MudSelectItem T="string" Value="@("price_asc")">Спочатку дешевші</MudSelectItem>
                    <MudSelectItem T="string" Value="@("price_desc")">Спочатку дорожчі</MudSelectItem>
                    <MudSelectItem T="string" Value="@("year_desc")">Спочатку новіші</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSwitch T="bool" @bind-Value="onlyAvailable" Color="Color.Primary" Label="Лише в наявності" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (!Filtered.Any())
    {
        <MudAlert Severity="Severity.Info">За вашими фільтрами автомобілів не знайдено.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var car in Filtered)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Class="car-card rounded-lg" Elevation="3">
                        <div class="car-photo">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Style="font-size:64px; color:rgba(255,255,255,.35);" />
                            @if (!string.IsNullOrEmpty(MainImage(car)))
                            {
                                <img src="@MainImage(car)" alt="@car.Brand @car.Model" loading="lazy"
                                     onerror="this.style.display='none'" />
                            }
                            <div class="car-badge">
                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(car.Status)" Variant="Variant.Filled">@StatusName(car.Status)</MudChip>
                            </div>
                            @if (isManager)
                            {
                                <div class="car-menu">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        <MudMenuItem OnClick="@(() => OpenEdit(car))">Змінити інформацію</MudMenuItem>
                                    </MudMenu>
                                </div>
                            }
                        </div>

                        <div class="pa-4" style="flex:1;">
                            <MudText Typo="Typo.h6">@car.Brand @car.Model</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@car.Trim</MudText>

                            <div class="d-flex flex-wrap" style="gap:16px;">
                                <span class="car-spec"><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />@car.Year</span>
                                <span class="car-spec"><MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" />@car.Mileage.ToString("N0") км</span>
                            </div>
                        </div>

                        <MudDivider />
                        <div class="pa-4 d-flex justify-space-between align-center">
                            <MudText Typo="Typo.h5" Color="Color.Primary">@car.Price.ToString("N0") $</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShoppingCart"
                                       Disabled="@(car.Status != 0)" OnClick="@(() => BookCar(car.Id))">
                                Забронювати
                            </MudButton>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
}
@if (editing != null)
{
    <div class="edit-backdrop" @onclick="CloseEdit">
        <div class="edit-modal" @onclick:stopPropagation="true">
            <MudText Typo="Typo.h5" Class="mb-4">Редагування: @editing.Brand @editing.Model</MudText>

            @if (!string.IsNullOrWhiteSpace(PreviewPhoto))
            {
                <img class="edit-preview mb-4" src="@PreviewPhoto" alt="" onerror="this.style.display='none'" />
            }

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="eBrand" Label="Марка" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="eModel" Label="Модель" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudTextField T="string" @bind-Value="eTrim" Label="Комплектація / короткий опис" Variant="Variant.Outlined" Lines="2" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="eYear" Label="Рік" Variant="Variant.Outlined" Min="1950" Max="2100" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField T="int" @bind-Value="eMileage" Label="Пробіг, км" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField T="decimal" @bind-Value="ePrice" Label="Ціна, $" Variant="Variant.Outlined" Min="0" /></MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="eStatus" Label="Статус" Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="0">В наявності</MudSelectItem>
                        <MudSelectItem T="int" Value="2">Заброньовано</MudSelectItem>
                        <MudSelectItem T="int" Value="1">Продано</MudSelectItem>
                        <MudSelectItem T="int" Value="3">Архів</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12"><MudTextField T="string" @bind-Value="ePhoto" Label="Посилання на фото (URL)" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Або виберіть файл з комп'ютера</MudText>
                    <InputFile OnChange="OnEditPhotoSelected" accept="image/*" />
                </MudItem>
            </MudGrid>

            <div class="d-flex justify-end mt-5" style="gap:8px;">
                <MudButton Variant="Variant.Text" OnClick="CloseEdit">Скасувати</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@saving" OnClick="SaveEdit">
                    @(saving ? "Збереження..." : "Зберегти")
                </MudButton>
            </div>
        </div>
    </div>
}
@code {
    private List<CarDto>? cars;
    private string search = "";
    private string brand = "";
    private string sort = "brand";
    private bool onlyAvailable;
    private bool isManager;
    private CarDto? editing;
    private bool saving;
    private string eBrand = "", eModel = "", eTrim = "", ePhoto = "";
    private int eYear, eMileage, eStatus;
    private decimal ePrice;
    private string ePhotoData = "";
    private string PreviewPhoto => !string.IsNullOrEmpty(ePhotoData) ? ePhotoData : ePhoto;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        isManager = state.User.IsInRole("Manager") || state.User.IsInRole("Administrator");

        await LoadCars();
    }

    private async Task LoadCars()
    {
        try
        {
            cars = await Http.GetFromJsonAsync<List<CarDto>>("https://localhost:7029/api/cars?size=100");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Помилка: {ex.Message}");
            cars ??= new();
        }
    }

       private void OpenEdit(CarDto car)
    {
        editing = car;
        eBrand = car.Brand;
        eModel = car.Model;
        eTrim = car.Trim;
        eYear = car.Year;
        eMileage = car.Mileage;
        ePrice = car.Price;
        eStatus = car.Status;

        var current = MainImage(car) ?? "";
        if (current.StartsWith("data:"))
        {
            ePhotoData = current;
            ePhoto = "";
        }
        else
        {
            ePhotoData = "";
            ePhoto = current;
        }
    }

    private void CloseEdit() => editing = null;

    private async Task SaveEdit()
    {
        if (editing == null) return;

        if (string.IsNullOrWhiteSpace(eBrand) || string.IsNullOrWhiteSpace(eModel) || ePrice <= 0)
        {
            Snackbar.Add("Заповніть марку, модель і ціну", Severity.Warning);
            return;
        }

        saving = true;
        try
        {
            var dto = new
            {
                Brand = eBrand.Trim(),
                Model = eModel.Trim(),
                Trim = eTrim.Trim(),
                Year = eYear,
                Mileage = eMileage,
                Price = ePrice,
                Status = eStatus,
                PhotoUrl = !string.IsNullOrEmpty(ePhotoData) ? ePhotoData : (string.IsNullOrWhiteSpace(ePhoto) ? null : ePhoto.Trim())
            };

            var response = await Http.PutAsJsonAsync($"https://localhost:7029/api/cars/{editing.Id}/details", dto);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Інформацію про авто оновлено", Severity.Success);
                editing = null;
                await LoadCars();
            }
            else
            {
                Snackbar.Add($"Помилка: {await response.Content.ReadAsStringAsync()}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Помилка: {ex.Message}", Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private List<CarDto> Filtered
    {
        get
        {
            if (cars == null) return new();
            var q = cars.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(search))
                q = q.Where(c => $"{c.Brand} {c.Model} {c.Trim}".Contains(search, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(brand))
                q = q.Where(c => c.Brand == brand);
            if (onlyAvailable)
                q = q.Where(c => c.Status == 0);

            q = sort switch
            {
                "price_asc" => q.OrderBy(c => c.Price),
                "price_desc" => q.OrderByDescending(c => c.Price),
                "year_desc" => q.OrderByDescending(c => c.Year),
                _ => q.OrderBy(c => c.Brand).ThenBy(c => c.Model)
            };
            return q.ToList();
        }
    }

    private async Task BookCar(int carId)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();

        if (!int.TryParse(state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var clientId))
        {
            Snackbar.Add("Увійдіть або зареєструйтесь, щоб додати авто в кошик", Severity.Info);
            Nav.NavigateTo("/login");
            return;
        }

        if (!state.User.IsInRole("Client"))
        {
            Snackbar.Add("Кошик доступний лише клієнтам", Severity.Warning);
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("https://localhost:7029/api/requests", new { CarId = carId, ClientId = clientId });
            if (response.IsSuccessStatusCode)
                Snackbar.Add("Авто додано в кошик", Severity.Success);
            else
                Snackbar.Add("Помилка при додаванні в кошик.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Помилка: {ex.Message}", Severity.Warning);
        }
    }

    private async Task OnEditPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (!file.ContentType.StartsWith("image/"))
        {
            Snackbar.Add("Оберіть файл зображення", Severity.Warning);
            return;
        }

        try
        {
            var resized = await file.RequestImageFileAsync("image/jpeg", 900, 600);
            using var stream = resized.OpenReadStream(3 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ePhotoData = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Не вдалося прочитати фото: {ex.Message}", Severity.Error);
        }
    }

    private static string? MainImage(CarDto car) =>
        (car.Images.FirstOrDefault(i => i.IsMain) ?? car.Images.FirstOrDefault())?.Url;

    // Статуси авто: 0 Available, 1 Sold, 2 Reserved, 3 Archived
    private static string StatusName(int status) => status switch
    {
        0 => "В наявності",
        1 => "Продано",
        2 => "Заброньовано",
        3 => "Архів",
        _ => "Невідомо"
    };

    private static Color StatusColor(int status) => status switch
    {
        0 => Color.Success,
        1 => Color.Error,
        2 => Color.Warning,
        _ => Color.Default
    };

    public class CarDto
    {
        public int Id { get; set; }
        public string Brand { get; set; } = "";
        public string Model { get; set; } = "";
        public string Trim { get; set; } = "";
        public int Year { get; set; }
        public int Mileage { get; set; }
        public decimal Price { get; set; }
        public int Status { get; set; }
        public List<CarImageDto> Images { get; set; } = new();
    }

    public class CarImageDto
    {
        public string Url { get; set; } = "";
        public bool IsMain { get; set; }
    }
}