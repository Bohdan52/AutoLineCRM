@page "/login"
@inject HttpClient Http

<h3>Вхід у систему</h3>

<div class="row">
    <div class="col-md-4">
        <input class="form-control mb-2" placeholder="Логін" @bind="loginDto.Login" />
        <input class="form-control mb-2" type="password" placeholder="Пароль" @bind="loginDto.Password" />
        <button class="btn btn-primary" @onclick="HandleLogin">Увійти</button>

        @if (message != null)
        {
            <div class="alert alert-info mt-3">@message</div>
        }
    </div>
</div>

@code {
    private LoginDto loginDto = new();
    private string? message;

    private async Task HandleLogin()
    {
        try
        {
            // Увага: використовуємо порт твого UserAuthService!
            var response = await Http.PostAsJsonAsync("https://localhost:7281/api/auth/login", loginDto);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponse>();
                message = $"Успіх! Ваш токен: {result?.Token.Substring(0, 15)}...";
            }
            else
            {
                message = "Помилка: невірний логін або пароль.";
            }
        }
        catch (Exception ex)
        {
            message = $"Помилка з'єднання: {ex.Message}";
        }
    }

    public class LoginDto { public string Login { get; set; } = ""; public string Password { get; set; } = ""; }
    public class AuthResponse { public string Token { get; set; } = ""; }
}