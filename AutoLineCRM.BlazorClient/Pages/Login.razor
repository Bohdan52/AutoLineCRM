@page "/login"
@inject HttpClient Http
@inject D20Tek.Blazor.BrowserStorage.ILocalStorageService Storage
@inject NavigationManager NavManager
@using MudBlazor

<div class="d-flex justify-center align-center" style="min-height: 60vh;">
    <MudPaper Elevation="6" Class="pa-8 rounded-lg" Width="400px">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6" Color="Color.Primary">Вхід</MudText>

        <MudTextField @bind-Value="loginDto.Login"
                      Label="Логін"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Person"
                      Class="mb-4" />

        <MudTextField @bind-Value="loginDto.Password"
                      Label="Пароль"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Lock"
                      Class="mb-6" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   OnClick="HandleLogin"
                   Disabled="@isLoading">
            @if (isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Зачекайте...</span>
            }
            else
            {
                <span>Увійти</span>
            }
        </MudButton>

        @if (message != null)
        {
            <MudAlert Severity="@alertColor" Class="mt-4">@message</MudAlert>
        }
    </MudPaper>
</div>

@code {
    private LoginDto loginDto = new();
    private string? message;
    private Severity alertColor = Severity.Info;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        message = null;

        try
        {
            var response = await Http.PostAsJsonAsync("https://localhost:7029/api/auth/login", loginDto);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponse>();

                if (result?.Token != null)
                {
                    // ЗБЕРІГАЄМО ТОКЕН У БРАУЗЕРІ
                    await Storage.SetAsync("authToken", result.Token);

                    message = "Успіх! Ви увійшли. Перенаправлення...";
                    alertColor = Severity.Success;

                    // Переходимо на каталог
                    NavManager.NavigateTo("/catalog");
                }
            }
            else
            {
                message = "Помилка: невірний логін або пароль.";
                alertColor = Severity.Error;
            }
        }
        catch (Exception ex)
        {
            message = $"Помилка з'єднання: {ex.Message}";
            alertColor = Severity.Warning;
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginDto { public string Login { get; set; } = ""; public string Password { get; set; } = ""; }
    public class AuthResponse { public string Token { get; set; } = ""; }
}