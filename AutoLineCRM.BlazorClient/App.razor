@using Microsoft.AspNetCore.Components.Authorization

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <div class="pa-8">
                        <MudAlert Severity="Severity.Error" Class="mt-4">
                            <MudText Typo="Typo.h6">Доступ заборонено</MudText>
                            <MudText>У вас немає прав для перегляду цієї сторінки. Будь ласка, увійдіть як менеджер або адміністратор.</MudText>
                        </MudAlert>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1d4ed8",
            Secondary = "#64748b",
            AppbarBackground = "#0f172a",
            Background = "#f1f5f9"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" }
    };
}